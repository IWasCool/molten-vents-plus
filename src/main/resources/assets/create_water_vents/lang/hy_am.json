  "create_water_vents.ponder.molten_vent_activation.header": "Օգտագործելով հալած օդանցք",
  "create_water_vents.ponder.molten_vent_activation.text_1": "Գտեք բաց միջուկը օդանցքի կենտրոնում:",
  "create_water_vents.ponder.molten_vent_activation.text_2": "Մաքրել տարածությունը միջուկի շուրջ: Պահպանեք միջուկը անձեռնմխելի:",
  "create_water_vents.ponder.molten_vent_activation.text_3": "Ակտիվացրեք միջուկը պայթյունով:",
  "create_water_vents.ponder.molten_vent_activation.text_4": "Տեղադրեք լավայի աղբյուր ակտիվ միջուկի կողքին:",
  "create_water_vents.ponder.molten_vent_activation.text_5": "Հանքափորեք քարը, ապա ավելացրեք լավայի մեկ այլ աղբյուր։",
  "create_water_vents.ponder.molten_vent_activation.text_6": "Փշրեք օդանցքի քարը ռեսուրսների համար: Ստուգեք JEI-ը կաթիլների համար:",
  "create_water_vents.ponder.molten_vent_automation.header": "Հալած օդանցքի ավտոմատացում",
  "create_water_vents.ponder.molten_vent_automation.text_1": "Մեկ բաց թողեք ակտիվ միջուկի կողքին:",
  "create_water_vents.ponder.molten_vent_automation.text_2": "Օգտագործեք լավայի ցանկացած պաշար: Այս օրինակում օգտագործվում են կաթիլային կաթսաներ:",
  "create_water_vents.ponder.molten_vent_automation.text_3": "Լավա մղեք միջուկի կողքին գտնվող տարածություն:",
  "create_water_vents.ponder.molten_vent_automation.text_4": "Էլեկտրաէներգիայի տակ դրեք հորատանցքը՝ առաջացած քարը հավաքելու համար:",
  "create_water_vents.ponder.molten_vent_automation.text_5": "Հավաքեք քարը գայլիկոնի տակ, ապա մշակեք այն։",
  "create_water_vents.ponder.water_vent_activation.header": "Ջրի կափույր",
  "create_water_vents.ponder.water_vent_activation.text_1": "Գտեք բաց միջուկը օդանցքի կենտրոնում:",
  "create_water_vents.ponder.water_vent_activation.text_2": "Մաքրել տարածությունը միջուկի շուրջ: Պահպանեք միջուկը անձեռնմխելի:",
  "create_water_vents.ponder.water_vent_activation.text_3": "Ակտիվացրեք միջուկը պայթյունով:",
  "create_water_vents.ponder.water_vent_activation.text_4": "Տեղադրեք ջրի աղբյուր ակտիվ միջուկի կողքին:",
  "create_water_vents.ponder.water_vent_activation.text_5": "Հանքահանիր քարը, հետո ավելացրու ջրի մեկ այլ աղբյուր։",
  "create_water_vents.ponder.water_vent_activation.text_6": "Աղացեք անմաքուր քարը՝ պաշարներ ստանալու փոքր հնարավորությամբ։",
  "create_water_vents.ponder.water_vent_automation.header": "Ջրի կափույր · Create",
  "create_water_vents.ponder.water_vent_automation.text_1": "Մեկ բաց թողեք ակտիվ միջուկի կողքին:",
  "create_water_vents.ponder.water_vent_automation.text_2": "Այս պոմպը մատակարարում է 2x2 անսահման ջրավազան:",
  "create_water_vents.ponder.water_vent_automation.text_3": "Անսահման լողավազանից ջուր մղեք միջուկի կողքին գտնվող տարածություն:",
  "create_water_vents.ponder.water_vent_automation.text_4": "Էլեկտրաէներգիայի տակ դրեք հորատանցքը՝ առաջացած քարը հավաքելու համար:",
  "create_water_vents.ponder.water_vent_automation.text_5": "Հավաքեք քարը գայլիկոնի տակ, ապա մշակեք այն։",
