  "command.create_water_vents.movement.enabled": "அனைத்து துவாரங்களையும் இப்போது நகர்த்த முடியும்.",
  "command.create_water_vents.movement.disabled": "அனைத்து துவாரங்களும் இப்போது அசையாது.",
  "create_water_vents.ponder.molten_vent_activation.header": "உருகிய வென்ட்டைப் பயன்படுத்துதல்",
  "create_water_vents.ponder.molten_vent_activation.text_1": "காற்றோட்டத்தின் மையத்தில் வெளிப்படும் மையத்தைக் கண்டறியவும்.",
  "create_water_vents.ponder.molten_vent_activation.text_2": "மையத்தைச் சுற்றி தெளிவான இடம். மையத்தை அப்படியே வைத்திருங்கள்.",
  "create_water_vents.ponder.molten_vent_activation.text_3": "வெடிப்புடன் மையத்தை இயக்கவும்.",
  "create_water_vents.ponder.molten_vent_activation.text_4": "செயலில் உள்ள மையத்திற்கு அருகில் எரிமலைக்குழம்பு மூலத்தை வைக்கவும்.",
  "create_water_vents.ponder.molten_vent_activation.text_5": "கல்லை என்னுடையது, பிறகு மற்றொரு எரிமலைக்குழம்பு மூலத்தைச் சேர்க்கவும்.",
  "create_water_vents.ponder.molten_vent_activation.text_6": "வளங்களுக்காக வென்ட் கல்லை நசுக்கவும். சொட்டுகளுக்கு JEI பார்க்கவும்.",
  "create_water_vents.ponder.molten_vent_automation.header": "உருகிய காற்றோட்டத்தை தானியக்கமாக்குதல்",
  "create_water_vents.ponder.molten_vent_automation.text_1": "செயலில் உள்ள மையத்திற்கு அருகில் ஒரு இடத்தை விடவும்.",
  "create_water_vents.ponder.molten_vent_automation.text_2": "ஏதேனும் எரிமலைக்குழம்பு விநியோகத்தைப் பயன்படுத்தவும். இந்த உதாரணம் சொட்டுக்கல் கொப்பரைகளைப் பயன்படுத்துகிறது.",
  "create_water_vents.ponder.molten_vent_automation.text_3": "லாவாவை மையத்திற்கு அருகில் உள்ள இடத்தில் செலுத்தவும்.",
  "create_water_vents.ponder.molten_vent_automation.text_4": "உருவாக்கப்பட்ட கல்லை அறுவடை செய்ய துரப்பணத்தை இயக்கவும்.",
  "create_water_vents.ponder.molten_vent_automation.text_5": "துரப்பணத்திற்கு கீழே உள்ள கல்லை சேகரித்து, பின்னர் அதை செயலாக்கவும்.",
  "create_water_vents.ponder.water_vent_activation.header": "வாட்டர் வென்ட்",
  "create_water_vents.ponder.water_vent_activation.text_1": "காற்றோட்டத்தின் மையத்தில் வெளிப்படும் மையத்தைக் கண்டறியவும்.",
  "create_water_vents.ponder.water_vent_activation.text_2": "மையத்தைச் சுற்றி தெளிவான இடம். மையத்தை அப்படியே வைத்திருங்கள்.",
  "create_water_vents.ponder.water_vent_activation.text_3": "வெடிப்புடன் மையத்தை இயக்கவும்.",
  "create_water_vents.ponder.water_vent_activation.text_4": "செயலில் உள்ள மையத்திற்கு அருகில் ஒரு நீர் ஆதாரத்தை வைக்கவும்.",
  "create_water_vents.ponder.water_vent_activation.text_5": "கல்லை என்னுடையது, பிறகு மற்றொரு நீர் ஆதாரத்தைச் சேர்க்கவும்.",
  "create_water_vents.ponder.water_vent_activation.text_6": "வளங்கள் கிடைக்கும் சிறிய வாய்ப்பிற்காகத் தூய்மையற்ற கல்லை ஆலைக்கல்லில் அரைக்கவும்.",
  "create_water_vents.ponder.water_vent_automation.header": "நீர் வென்ட் · Create",
  "create_water_vents.ponder.water_vent_automation.text_1": "செயலில் உள்ள மையத்திற்கு அருகில் ஒரு இடத்தை விடவும்.",
  "create_water_vents.ponder.water_vent_automation.text_2": "2x2 எல்லையற்ற நீர்க் குளம் இந்த பம்பை வழங்குகிறது.",
  "create_water_vents.ponder.water_vent_automation.text_3": "எல்லையற்ற குளத்திலிருந்து நீரை மையத்திற்கு அருகில் உள்ள இடத்திற்குள் பம்ப் செய்யவும்.",
  "create_water_vents.ponder.water_vent_automation.text_4": "உருவாக்கப்பட்ட கல்லை அறுவடை செய்ய துரப்பணத்தை இயக்கவும்.",
  "create_water_vents.ponder.water_vent_automation.text_5": "துரப்பணத்திற்கு கீழே உள்ள கல்லை சேகரித்து, பின்னர் அதை செயலாக்கவும்.",
  "create_water_vents.ponder.superheated_vent_activation.header": "சூப்பர் ஹீட் வென்ட்",
  "create_water_vents.ponder.superheated_vent_activation.text_1": "காற்றோட்டத்தின் மையத்தில் வெளிப்படும் மையத்தைக் கண்டறியவும்.",
  "create_water_vents.ponder.superheated_vent_activation.text_2": "மையத்தைச் சுற்றி தெளிவான இடம். மையத்தை அப்படியே வைத்திருங்கள்.",
  "create_water_vents.ponder.superheated_vent_activation.text_3": "வெடிப்புடன் மையத்தை இயக்கவும்.",
  "create_water_vents.ponder.superheated_vent_activation.text_4": "செயலில் உள்ள மையத்திற்கு அருகில் ஒரு சூப்பர் ஹீட் லாவா மூலத்தை வைக்கவும்.",
  "create_water_vents.ponder.superheated_vent_activation.text_5": "தூய கல்லை என்னுடையது, பின்னர் மற்றொரு சூப்பர் ஹீட் எரிமலை மூலத்தை சேர்க்கவும்.",
  "create_water_vents.ponder.superheated_vent_activation.text_6": "கூடுதல் நொறுக்கப்பட்ட தாதுக்கள் மற்றும் நகட்களுக்கு தூய கல்லை நசுக்கவும், அதிக கல் அல்ல.",
  "create_water_vents.ponder.superheated_vent_automation.header": "சூப்பர் ஹீட் வென்ட் · Create",
  "create_water_vents.ponder.superheated_vent_automation.text_1": "செயலில் உள்ள மையத்திற்கு அருகில் ஒரு இடத்தை விடவும்.",
  "create_water_vents.ponder.superheated_vent_automation.text_2": "சூப்பர் ஹீட் லாவாவை உருவாக்க ஒரு பேசின் மீது ஒரு இயந்திர அழுத்தத்தை செலுத்தவும்.",
  "create_water_vents.ponder.superheated_vent_automation.text_3": "1000 mB எரிமலைக்குழம்பு + ஒரு பிளேஸ் கேக் + அப்சிடியன் தூசி 500 mB அதிசூடான எரிமலைக்குழம்புகளை உருவாக்குகிறது. ஒரு வாளிக்கு இரண்டு முறை அழுத்தவும்.",
  "create_water_vents.ponder.superheated_vent_automation.text_4": "அதிசூடேற்றப்பட்ட எரிமலைக்குழம்பு மையப்பகுதிக்கு அருகில் உள்ள இடத்திற்குள் செலுத்தவும்.",
  "create_water_vents.ponder.superheated_vent_automation.text_5": "உருவாக்கப்பட்ட கல்லை அறுவடை செய்ய துரப்பணத்தை இயக்கவும்.",
